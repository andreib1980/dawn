#!/bin/bash
#
# Pre-push hook — verify the CI test suite passes before pushing.
#
# Catches regressions that get past the developer's local workflow: missing
# test stubs, production code broken on paths only exercised by tests, code
# that compiles but fails at runtime.  This session's `fact_stems` column
# bug + 4 missing test stubs are the motivating example.
#
# Install: ./install-git-hooks.sh
# Bypass:  git push --no-verify
#

# Change to repository root
cd "$(git rev-parse --show-toplevel)" || exit 1

# Color output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Find an existing build directory.  Prefer build-debug (the developer's
# daily driver per CLAUDE.md); fall back to build-ci (CI's choice) or other
# variants the developer may have configured.
BUILD_DIR=""
for d in build-debug build-ci build-full build; do
   if [ -f "$d/CMakeCache.txt" ]; then
      BUILD_DIR="$d"
      break
   fi
done

if [ -z "$BUILD_DIR" ]; then
   echo -e "${YELLOW}Pre-push: no build directory found; skipping test check.${NC}"
   echo -e "${YELLOW}  Bootstrap with: cmake --preset debug${NC}"
   exit 0
fi

BUILD_LOG=$(mktemp -t dawn-prepush-build.XXXXXX.log)
TEST_LOG=$(mktemp -t dawn-prepush-test.XXXXXX.log)
trap 'rm -f "$BUILD_LOG" "$TEST_LOG"' EXIT

echo -e "${BLUE}Pre-push: building tests-ci in $BUILD_DIR…${NC}"
if ! make -C "$BUILD_DIR" -j"$(nproc)" tests-ci > "$BUILD_LOG" 2>&1; then
   echo -e "${RED}Test build FAILED.  Last 30 lines:${NC}"
   tail -30 "$BUILD_LOG"
   echo
   echo -e "${YELLOW}Bypass: git push --no-verify${NC}"
   # Preserve the log on failure for the dev to inspect.
   PRESERVED=$(mktemp -t dawn-prepush-build-failed.XXXXXX.log)
   cp "$BUILD_LOG" "$PRESERVED"
   echo -e "${YELLOW}Full log preserved at: $PRESERVED${NC}"
   exit 1
fi

echo -e "${BLUE}Pre-push: running CI test suite…${NC}"
if ! ctest --test-dir "$BUILD_DIR" --output-on-failure --no-tests=error -L ci > "$TEST_LOG" 2>&1; then
   echo -e "${RED}Test suite FAILED.  Failing cases:${NC}"
   # Highlight FAIL/Failed lines + tail the summary block.
   grep -E "FAIL:|\*\*\*Failed|tests failed" "$TEST_LOG" | head -20
   echo
   echo -e "${YELLOW}Reproduce: ctest --test-dir $BUILD_DIR --output-on-failure -L ci${NC}"
   echo -e "${YELLOW}Bypass:    git push --no-verify${NC}"
   PRESERVED=$(mktemp -t dawn-prepush-test-failed.XXXXXX.log)
   cp "$TEST_LOG" "$PRESERVED"
   echo -e "${YELLOW}Full log preserved at: $PRESERVED${NC}"
   exit 1
fi

# Success — pull the pass count for a clean summary line.
PASS_LINE=$(grep -E "tests passed" "$TEST_LOG" | tail -1)
if [ -n "$PASS_LINE" ]; then
   echo -e "${GREEN}Pre-push: $PASS_LINE${NC}"
else
   echo -e "${GREEN}Pre-push: test suite passed.${NC}"
fi

exit 0
