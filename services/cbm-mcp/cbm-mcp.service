[Unit]
Description=Codebase Memory (cbm) MCP server via mcp-proxy SSE bridge for DAWN
Documentation=https://github.com/DeusData/codebase-memory-mcp
After=network.target

[Service]
Type=simple
User=dawn
Group=dawn
WorkingDirectory=/var/lib/dawn

Environment="HOME=/var/lib/dawn"
EnvironmentFile=/usr/local/etc/cbm-mcp/cbm-mcp.conf

# mcp-proxy runs the stdio cbm binary as its OWN child and re-exposes it over SSE
# on ${HOST}:${PORT}/sse — the transport DAWN's MCP bridge connects to. (DAWN
# never spawns cbm itself; the adapter owns that child.) cbm's own settings
# (cache dir, log level, optional worker count) are forwarded to the child via -e.
# The /bin/sh wrapper expands the EnvironmentFile vars and supports the optional
# CBM_WORKERS arg, mirroring services/llama-server/llama-server.service.
ExecStart=/bin/sh -c 'exec "${MCP_PROXY}" \
  --host "${HOST}" \
  --port "${PORT}" \
  -e CBM_CACHE_DIR "${CBM_CACHE_DIR}" \
  -e CBM_LOG_LEVEL "${CBM_LOG_LEVEL}" \
  ${CBM_WORKERS:+-e CBM_WORKERS "${CBM_WORKERS}"} \
  -- "${CBM_BIN}"'

# Logging (shares /var/log/dawn with dawn-server; rotated by cbm-mcp logrotate)
StandardOutput=append:/var/log/dawn/cbm-mcp.log
StandardError=append:/var/log/dawn/cbm-mcp.log

# Restart policy
Restart=on-failure
RestartSec=10s
StartLimitInterval=5min
StartLimitBurst=3

# Security hardening. cbm only READS the clone tree (/var/lib/dawn/source) and
# WRITES its graph cache; ProtectSystem=strict leaves the whole FS read-only
# except the explicitly listed ReadWritePaths.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/dawn/cbm-cache /var/log/dawn

# --- Link-local repos (opt-in; OFF by default) ------------------------------
# To let cbm index repositories OUTSIDE /var/lib/dawn/source (the [code_projects]
# `allowed_local_roots` feature, and Claude Code indexing its own repos through
# the shared SSE endpoint), this sandboxed unit must be granted READ access to
# those trees. ProtectHome=true above HIDES all of /home and DEFEATS ReadOnlyPaths,
# so the correct pattern is ProtectHome=tmpfs + a read-only bind PER allowed root.
#
# PREFERRED: let the installer do it — `install.sh --local-roots "/home/<user>/code"`
# (or answer the interactive prompt) writes a drop-in at
# /etc/systemd/system/cbm-mcp.service.d/10-local-roots.conf and the traverse ACLs.
# Re-run with new roots to update it; do NOT hand-edit this shipped unit.
#
# MANUAL fallback (if you must), as a drop-in so reinstalls don't clobber it:
#   sudo systemctl edit cbm-mcp    # creates the override.conf
#     [Service]
#     ProtectHome=tmpfs
#     BindReadOnlyPaths=/home/<user>/code:/home/<user>/code
#   sudo setfacl -m u:dawn:--x /home/<user>     # traverse to the bound root
#
# Keep the roots in sync with [code_projects].allowed_local_roots in dawn.toml, and
# do NOT add trees containing secrets (.env, secrets.toml) — cbm indexes file
# CONTENTS and they become reachable by the LLM. After any change:
# `systemctl daemon-reload` then restart this unit.
# ----------------------------------------------------------------------------

[Install]
WantedBy=multi-user.target
